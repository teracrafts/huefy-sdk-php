{
    "name": "teracrafts/huefy-sdk",
    "description": "Huefy - PHP SDK",
    "version": "1.0.0",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/teracrafts/huefy-sdk",
    "keywords": [
        "sdk",
        "api",
        "huefy"
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Huefy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Huefy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
